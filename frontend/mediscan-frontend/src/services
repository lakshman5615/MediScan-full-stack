// src/services/fcmService.js

import { initializeApp } from 'firebase/app';
import { getMessaging, getToken, onMessage } from 'firebase/messaging';

const firebaseConfig = {
  apiKey: "AIzaSyAX3A-Vc102Xx-uoAvIyh3sX4gzfGojXD4",
  authDomain: "mediscan-notifications.firebaseapp.com",
  projectId: "mediscan-notifications",
  messagingSenderId: "1094554203665",
  appId: "1:1094554203665:web:7b8d495c93d08416e8a3b0"
};

const app = initializeApp(firebaseConfig);
const messaging = getMessaging(app);

class FCMService {
  constructor() {
    this.token = null;
    this.setupForegroundListener();
  }

  async setupFCM() {
    try {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        console.log('Notification permission denied');
        return false;
      }

      const token = await getToken(messaging, {
        vapidKey: 'YOUR_VAPID_KEY'
      });

      if (token) {
        console.log('FCM Token:', token);
        this.token = token;
        await this.sendTokenToBackend(token);
        return true;
      }
      
      return false;
    } catch (error) {
      console.error('FCM setup error:', error);
      return false;
    }
  }

  setupForegroundListener() {
    onMessage(messaging, (payload) => {
      console.log('Foreground message received:', payload);
      
      // PREVENT DUPLICATE: Only handle action notifications in foreground
      if (payload.data?.showActions === 'true') {
        this.showActionNotification(payload);
      }
      // Normal notifications handled by service worker only
    });
  }

  showActionNotification(payload) {
    if ('serviceWorker' in navigator && 'PushManager' in window) {
      navigator.serviceWorker.ready.then(registration => {
        registration.showNotification(payload.notification.title, {
          body: payload.notification.body,
          icon: '/mediscan-icon.png',
          requireInteraction: true,
          data: payload.data,
          actions: [
            {
              action: `taken_${payload.data.medicineId}`,
              title: '✅ Taken'
            },
            {
              action: `missed_${payload.data.medicineId}`,
              title: '⏭️ Skip'
            }
          ]
        });
      });
    }
  }

  async sendTokenToBackend(token) {
    try {
      const authToken = localStorage.getItem('authToken');
      
      await fetch('http://localhost:5000/api/auth/fcm-token', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        },
        body: JSON.stringify({ fcmToken: token })
      });
      
      console.log('Token sent to backend');
    } catch (error) {
      console.error('Error sending token to backend:', error);
    }
  }
}

export default new FCMService();